# Telegram bot (von @BotFather)
TELEGRAM_TOKEN=123456:ABC-DEF...

# Token for the web admin panel (X-Admin-Token header)
ADMIN_TOKEN=change-me-please

# Comma-separated Telegram chat IDs that may issue admin commands.
# Leave empty during first setup, then run /start in your bot to learn your ID.
ADMIN_CHAT_IDS=

# CORS — set to your frontend origin in production, e.g. https://app.almalatina.de
CORS_ORIGIN=*
